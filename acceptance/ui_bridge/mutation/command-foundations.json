    "id": "STATUS-identifier-newline",
    "kind": "python",
    "target": "synapse/commands/reconciliation.schema.json",
    "before": "\"not\":{\"pattern\":\"[^A-Za-z0-9._:/-]\"}",
    "after": "\"not\":{\"pattern\":\"[^A-Za-z0-9._:/\\n-]\"}",
    "behavior": "Reject line terminators inside object identities",
