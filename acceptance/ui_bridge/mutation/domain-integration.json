    "cases": [
      "acceptance/ui_bridge/test_domain_session_acceptance.py"
    ]
  },
  {
    "id": "NATIVE-DOMAIN-correlation",
    "kind": "rust",
    "target": "synapse/ui/src-tauri/src/domain_protocol.rs",
    "before": "reply[\"request_id\"] != request[\"request_id\"]",
    "after": "false",
    "behavior": "Only the corresponding request can consume a reply.",
    "case": "domain_protocol"
  },
  {
    "id": "NATIVE-DOMAIN-method",
    "kind": "rust",
    "target": "synapse/ui/src-tauri/src/domain_protocol.rs",
    "before": "reply[\"method\"] != request[\"method\"]",
    "after": "false",
    "behavior": "A result from another method is not an answer.",
    "case": "domain_protocol"
  },
  {
    "id": "NATIVE-DOMAIN-schema",
    "kind": "rust",
    "target": "synapse/ui/src-tauri/src/domain_protocol.rs",
    "before": "!valid(&reply)",
    "after": "false",
    "behavior": "Unknown refusal vocabulary is rejected at the reply boundary.",
    "case": "domain_protocol"
  },
  {
    "id": "NATIVE-DOMAIN-instance-reuse",
    "kind": "rust",
    "target": "synapse/ui/src-tauri/src/client_identity.rs",
    "before": "if let Some(key) = read(&target)? { return Ok(key); }",
    "after": "if let Some(_key) = read(&target)? { /* replace registered identity */ }",
    "behavior": "Restart must reuse the registered private key.",
    "case": "client_identity"
  },
  {
    "id": "NATIVE-DOMAIN-credential-tag",
    "kind": "rust",
    "target": "synapse/ui/src-tauri/src/client_identity.rs",
    "before": "if &bytes[..5] != b\"SYNI\\x01\"",
    "after": "if false",
    "behavior": "A malformed credential is not an application identity.",
    "case": "client_identity"
  },
  {
    "id": "NATIVE-DOMAIN-credential-persistence",
    "kind": "rust",
    "target": "synapse/ui/src-tauri/src/client_identity.rs",
    "before": "item.Persist != CRED_PERSIST_LOCAL_MACHINE",
    "after": "false",
    "behavior": "Session-only key persistence does not satisfy restart recovery.",
    "case": "client_identity"
  },
  {
    "id": "NATIVE-DOMAIN-signature",
    "kind": "rust",
    "target": "synapse/ui/src-tauri/src/client_identity.rs",
    "before": "self.key.sign(&challenge)",
    "after": "self.key.sign(b\"different connection\")",
    "behavior": "A real Python verifier rejects a signature over a different challenge.",
