  },
  {
    "id": "NATIVE-DOMAIN-identity-selection",
    "kind": "rust",
    "target": "synapse/ui/src-tauri/src/client_identity.rs",
    "before": "\"public_key\":self.public_key()",
    "after": "\"public_key\":\"0\".repeat(64)",
    "behavior": "The signed native instance must match the registered public key.",
    "case": "application"
  },
  {
    "id": "NATIVE-DOMAIN-closed-renderer",
    "kind": "rust",
