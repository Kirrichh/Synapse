    "cases": [
      "acceptance/ui_bridge/test_domain_session_acceptance.py"
    ]
  },
  {
    "id": "DOMAIN-before-ready",
    "kind": "python",
    "target": "synapse/machine/domain_session.py",
    "before": "if not ready:",
    "after": "if False:",
