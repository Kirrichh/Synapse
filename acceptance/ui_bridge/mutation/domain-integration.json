      "acceptance/ui_bridge/test_domain_session_acceptance.py"
    ]
  },
  {
    "id": "DOMAIN-grant-list-expiry",
    "kind": "python",
    "target": "synapse/access/authority.py",
    "before": "and (grant.expires_at is None or now < grant.expires_at)",
    "after": "and True",
