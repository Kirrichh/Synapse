    "before": "rename_all=\"snake_case\", deny_unknown_fields",
    "after": "rename_all=\"snake_case\"",
    "behavior": "Renderer fields cannot assign native context.",
    "case": "application"
  },
  {
    "id": "NATIVE-DOMAIN-read-mutation",
    "kind": "rust",
    "target": "synapse/ui/src-tauri/src/application.rs",
