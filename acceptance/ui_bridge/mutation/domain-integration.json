  },
  {
    "id": "NATIVE-DOMAIN-retry-status",
    "kind": "rust",
    "target": "synapse/ui/src-tauri/src/application.rs",
    "before": "if previously_prepared { Self::recover_prepared(session, grant, prepared, true) }",
    "after": "if false && previously_prepared { Self::recover_prepared(session, grant, prepared, true) }",
