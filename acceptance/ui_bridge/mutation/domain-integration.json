  },
  {
    "id": "NATIVE-DOMAIN-selected-grant",
    "kind": "rust",
    "target": "synapse/ui/src-tauri/src/application.rs",
    "before": ".find(|value| value[\"grant_id\"].as_str() == Some(grant_id))",
    "after": ".find(|_| true)",
    "behavior": "An unlisted grant reference cannot select another granted scope.",
