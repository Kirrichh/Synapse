{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapse.local/schema/machine/envelope/1.0",
  "title": "MachineEnvelope",
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/select" },
    { "$ref": "#/$defs/ready" },
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/result" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "schemaVersion": { "const": "1.0" },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 64, "not": { "pattern": "[^A-Za-z0-9_-]" } },
    "frameLimit": { "type": "integer", "minimum": 1024, "maximum": 65536 },
    "profileId": { "const": "synapse.control.v1" },
    "controlMethod": { "enum": ["machine.ping", "machine.status", "machine.shutdown"] },
    "errorCode": {
      "enum": ["INVALID_LENGTH", "FRAME_TOO_LARGE", "TRUNCATED_FRAME", "INVALID_UTF8", "INVALID_JSON", "JSON_LIMIT", "SCHEMA_INVALID", "SCHEMA_UNSUPPORTED", "PROFILE_UNSUPPORTED", "INVALID_SEQUENCE", "NOT_READY", "METHOD_UNSUPPORTED", "PARAMS_INVALID", "HANDSHAKE_TIMEOUT", "WRITE_TIMEOUT", "PIPE_CLOSED", "INTERNAL_ERROR"]
    },
    "hello": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "type", "component", "component_version", "protocol_min", "protocol_max", "profile", "max_frame_bytes"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "type": { "const": "hello" },
        "component": { "enum": ["core", "shell"] },
        "component_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "protocol_min": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "protocol_max": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "profile": { "type": "string", "minLength": 1, "maxLength": 128 },
        "max_frame_bytes": { "$ref": "#/$defs/frameLimit" }
      }
    },
    "select": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "type", "profile", "protocol_version", "max_frame_bytes", "encoding", "framing"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "type": { "const": "select" },
        "profile": { "type": "string", "maxLength": 128 },
        "protocol_version": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "max_frame_bytes": { "$ref": "#/$defs/frameLimit" },
        "encoding": { "const": "utf-8" },
        "framing": { "const": "u32be" }
      }
    },
    "ready": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "type", "profile", "protocol_version", "max_frame_bytes", "command_classes", "domain_ready"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "type": { "const": "ready" },
        "profile": { "$ref": "#/$defs/profileId" },
        "protocol_version": { "const": 1 },
        "max_frame_bytes": { "$ref": "#/$defs/frameLimit" },
        "command_classes": { "const": ["control"] },
        "domain_ready": { "const": false }
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "type", "request_id", "method", "params"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "type": { "const": "request" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "method": { "type": "string", "minLength": 1, "maxLength": 80 },
        "params": { "type": "object", "maxProperties": 32 }
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "type", "request_id", "method", "result"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "type": { "const": "result" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "method": { "$ref": "#/$defs/controlMethod" },
        "result": { "type": "object" }
      },
      "oneOf": [
        { "properties": { "method": { "const": "machine.ping" }, "result": { "const": { "status": "alive" } } } },
        { "properties": { "method": { "const": "machine.shutdown" }, "result": { "const": { "status": "stopped", "pending_commands": 0 } } } },
        { "properties": { "method": { "const": "machine.status" }, "result": {
          "type": "object", "additionalProperties": false,
          "required": ["state", "domain_ready", "profile", "max_frame_bytes"],
          "properties": {
            "state": { "const": "ready" }, "domain_ready": { "const": false },
            "profile": { "$ref": "#/$defs/profileId" },
            "max_frame_bytes": { "$ref": "#/$defs/frameLimit" }
          }
        } } }
      ]
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "type", "code", "fatal"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "type": { "const": "error" },
        "code": { "$ref": "#/$defs/errorCode" },
        "fatal": { "type": "boolean" },
        "request_id": { "$ref": "#/$defs/requestId" }
      }
    }
  }
}
