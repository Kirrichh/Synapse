{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapse.local/schema/desktop/bootstrap/1.0",
  "title": "BootstrapSnapshot",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "session_id", "subscription_id", "sequence", "state", "domain_ready", "diagnostics"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "session_id": { "$ref": "#/$defs/identity" },
    "subscription_id": { "$ref": "#/$defs/identity" },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "state": { "enum": ["native", "connecting", "ready", "fail", "stopping", "stopped"] },
    "domain_ready": { "const": false },
    "core_version": { "type": "string", "maxLength": 128 },
    "process_id": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "profile": { "const": "synapse.control.v1" },
    "protocol_message": { "type": "string", "maxLength": 65536 },
    "code": { "$ref": "#/$defs/diagnosticCode" },
    "diagnostics": { "type": "array", "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 64, "not": { "pattern": "[^A-Z_]" } } }
  },
  "$defs": {
    "identity": { "type": "string", "minLength": 36, "maxLength": 36,
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$" },
    "diagnosticCode": { "enum": [
      "DESKTOP_REQUIRED", "CALLER_REFUSED", "ENVIRONMENT_UNSUPPORTED", "CORE_MISSING",
      "CORE_INTEGRITY", "CORE_VERSION", "SPAWN_FAILED", "CONTAINMENT_FAILED", "CORE_EXITED",
      "PROTOCOL_ERROR", "HANDSHAKE_TIMEOUT", "TRANSPORT_TIMEOUT", "SHUTDOWN_TIMEOUT",
      "RESTART_REQUIRED", "BUSY", "CORE_DIAGNOSTIC", "INTERNAL_ERROR",
      "INVALID_LENGTH", "FRAME_TOO_LARGE", "TRUNCATED_FRAME", "INVALID_UTF8", "INVALID_JSON", "JSON_LIMIT", "SCHEMA_INVALID", "SCHEMA_UNSUPPORTED", "PROFILE_UNSUPPORTED", "INVALID_SEQUENCE", "NOT_READY", "METHOD_UNSUPPORTED", "PARAMS_INVALID", "WRITE_TIMEOUT", "PIPE_CLOSED"
    ] }
  }
}
